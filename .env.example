# AgentRef — environment reference
# Copy to `.env.local` and fill in only what you need.
#
# The app targets the deployed AgentRef Intelligent Contract on **GenLayer
# Studio Next** (chain 61997, RPC https://studio-next.genlayer.com/api), see
# src/core/genlayer/contract.ts → STUDIO_NEXT / LIVE_CONTRACT.
#
# Env is read in src/core/genlayer/config.ts (client-safe) and
# src/core/genlayer/runtime.ts (server-only).

# ---------------------------------------------------------------------------
# GenLayer — the REAL validator path (Studio Next)
# ---------------------------------------------------------------------------
# Address of the deployed single-receipt contract. REQUIRED until a default is
# built into src/core/genlayer/contract.ts → STUDIO_NEXT_CONTRACT_ADDRESS;
# while it is unset the app reports `not-configured` and will not read or write
# any contract rather than guess an address.
NEXT_PUBLIC_AGENTREF_CONTRACT_ADDRESS=

# Network label. studio_next maps to the genlayer-js `studioDevnet` chain
# export (chain id 61997) with this app's RPC + explorer attached.
# studio_next | testnet_bradbury | testnet_asimov | studionet | localnet
NEXT_PUBLIC_AGENTREF_NETWORK=studio_next

# OPTIONAL: force a different genlayer-js/chains export than the network
# default (studioDevnet). You normally do NOT need this.
# NEXT_PUBLIC_AGENTREF_CHAIN_KEY=studioDevnet

# Server-only signer for the WRITE path (create_receipt → challenge →
# adjudicate). NEVER prefix with NEXT_PUBLIC_, never commit, never expose to
# the client. Must be a 0x-prefixed 64-hex private key funded on Studio Next.
#
# AGENTBEE_ACCOUNT_PRIVATE_KEY is the name Production sets.
# AGENTREF_ACCOUNT_PRIVATE_KEY is the older name and is still honoured
# (checked second), so existing deployments keep working.
#
# Without a key the app can still READ the shared on-chain verdict — it just
# cannot sign new adjudications, and it falls back to the clearly labelled
# SIMULATED path instead.
# AGENTBEE_ACCOUNT_PRIVATE_KEY=
# AGENTREF_ACCOUNT_PRIVATE_KEY=
# AGENTREF_ACCOUNT_NAME=agentref
