# AgentRef — environment reference
# Copy to `.env.local` and fill in only what you need. The app runs fully with
# NO GenLayer configuration — it uses the clearly-labelled SIMULATED adjudicator
# (src/core/evaluate.ts) and never claims validator consensus.
#
# Env is read in src/core/genlayer/config.ts (client-safe) and
# src/core/genlayer/runtime.ts (server-only).

# ---------------------------------------------------------------------------
# GenLayer — the REAL validator path (optional)
# ---------------------------------------------------------------------------
# 1) Deploy genlayer/contract.py (see genlayer/README.md).
# 2) Set NEXT_PUBLIC_AGENTREF_CONTRACT_ADDRESS to the deployed address.
# 3) Pick the network. Default is testnet_bradbury.
NEXT_PUBLIC_AGENTREF_CONTRACT_ADDRESS=
# NEXT_PUBLIC_AGENTREF_NETWORK=testnet_bradbury   # testnet_bradbury | testnet_asimov | studionet | localnet
#
# genlayer-js/chains exports are camelCase (testnetBradbury, testnetAsimov,
# studionet, localnet). The network label maps to the right export
# automatically, so you usually do NOT need the next line. Set it only to force
# a different chain than the network default:
# NEXT_PUBLIC_AGENTREF_CHAIN_KEY=testnetBradbury

# Server-only signer for submitting disputes (write path). NEVER prefix with
# NEXT_PUBLIC_, never commit, never expose to the client. Must be a 0x-prefixed
# 64-hex private key funded on the target network (use the official faucet:
# testnet-faucet.genlayer.foundation). Reading rulings needs no key.
# AGENTREF_ACCOUNT_PRIVATE_KEY=
# AGENTREF_ACCOUNT_NAME=agentref
